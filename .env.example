# Local environment template — DSH user standards bundle
#
# The harness provides these at runtime; they are documented here for local
# tooling only. Copy to .env.local if a script needs them, and NEVER commit
# real values. No secrets are used by this bundle.

# Absolute path to the DSH profile directory (e.g. C:\Users\EDY\.dsh\profiles\desktop)
DSH_PROFILE_DIR=

# Absolute path to the DSH home directory (e.g. C:\Users\EDY\.dsh)
DSH_HOME=

# Node/Electron executable used for offline checks (Electron-as-node mode)
DSH_NODE_EXECUTABLE=

# Web GUI port for the live health check (defaults to 61098)
DSH_WEB_PORT=61098

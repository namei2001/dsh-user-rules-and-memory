{
  "name": "@local/dsh-user-standards",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Durable, cross-project user standards for DeepSeek Harness: proactive settings, conservative nudge reminders, and one-click save from any project.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "scripts",
    "tests",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
